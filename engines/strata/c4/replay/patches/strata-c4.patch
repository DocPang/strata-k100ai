+    float qm = 0.0f;
+    for (int i = t; i < G * HD; i += MTHREADS) qm = fmaxf(qm, fabsf(q[i]));
+#pragma unroll
+    for (int o = 32; o > 0; o >>= 1) qm = fmaxf(qm, __shfl_xor_sync(0xffffffffffffffffull, qm, o, 64));
