+template <int MT, int NT, int KS>
+static void launch(const int8_t* codes, const float* wsc, const Q8D4* x, const int* bounds, uint16_t* y,
+                   int N, int K, int total_rows, int max_rows, int n, hipStream_t s) {
+    constexpr int BM = 16 * MT * 4, BN = 16 * NT;
+    dim3 g((unsigned)((max_rows + BM - 1) / BM), (unsigned)((N + BN - 1) / BN), (unsigned)n);
+    if (MT == 1) kdn_v11_kernel<MT, NT, KS><<<g, 256, 0, s>>>(codes, wsc, x, bounds, y, N, K, total_rows);
