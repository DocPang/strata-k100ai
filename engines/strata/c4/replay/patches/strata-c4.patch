+            for (int ks = 0; ks < 2; ++ks) {
+                mm_h4 ah, al;
+#pragma unroll
+                for (int k = 0; k < 4; ++k) {
+                    const int c = ks * 16 + grp * 4 + k;
+                    const float pv = S.p[r][c] * (S.vs[wave][c] * vup);
+                    const _Float16 hi = (_Float16) pv;
+                    ah[k] = hi;
+                    al[k] = (_Float16) (pv - (float) hi);
+                }
+#pragma unroll
+                for (int j = 0; j < 4; ++j) {
+                    mm_h4 b;
+#pragma unroll
+                    for (int k = 0; k < 4; ++k) b[k] = S.v[wave][ks * 16 + grp * 4 + k][j * 16 + r];
+                    tmp[j] = mmac16(ah, b, tmp[j]);
+                    if constexpr (SPLIT) tmp[j] = mmac16(al, b, tmp[j]);
+                }
+            }
+            const float ar = S.alpha[r];
+#pragma unroll
+            for (int j = 0; j < 4; ++j)
+#pragma unroll
+                for (int m = 0; m < 4; ++m) acc[j][m] = fmaf(acc[j][m], ar, tmp[j][m] * vdown);
+        }
+    }
+    const float l = S.lsum[r];
+    const float inv = l > 0.0f ? 1.0f / l : 0.0f;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int m = 0; m < 4; ++m)
+            if (r < G) attn[(size_t) r * HD + dim0 + j * 16 + grp + 4 * m] = acc[j][m] * inv;
