+        __syncthreads();
+    }
+#pragma unroll
+    for (int mt = 0; mt < MT; mt++)
+#pragma unroll
+        for (int nt = 0; nt < NT; nt++)
+#pragma unroll
+            for (int j = 0; j < 4; j++) {
+                const int ar = m0 + (wave * MT + mt) * 16 + lg + 4 * j;
+                const int wr = n0 + nt * 16 + lr;
