+__global__ void expand_iq3xxs_kernel(const uint8_t* __restrict__ w,int8_t* __restrict__ codes,float* __restrict__ scales,int nb_per_expert,int ne,int N,int K){
+ __shared__ uint32_t sG3[256];__shared__ uint8_t sK3[128];
+ for(int i=threadIdx.x;i<256;i+=blockDim.x) sG3[i]=G3D[i];
+ for(int i=threadIdx.x;i<128;i+=blockDim.x) sK3[i]=K3D[i];
+ __syncthreads();
+ GATEUP_EXPAND_PROLOGUE;
+ const uint8_t* blk=w+(size_t)gid*98;
+ const float d=__half2float(*reinterpret_cast<const __half*>(blk));
+ const uint8_t* qs=blk+2;const uint8_t* ss=qs+64;
+ float* sc=scales+((size_t)e*N+row)*(K/32)+(size_t)(b%kb_per_row)*8;
+ const int ib=idx>>2, l=idx&3;
+ uint32_t aux;__builtin_memcpy(&aux,ss+4*ib,4);
+ const uint8_t sg=sK3[(aux>>(7*l))&127];
+ const uint8_t* p1=(const uint8_t*)(sG3+qs[8*ib+2*l]);
+ const uint8_t* p2=(const uint8_t*)(sG3+qs[8*ib+2*l+1]);
+ uint32_t lo=0,hi=0;
+ #pragma unroll
+ for(int j=0;j<4;j++){
+  lo|=(uint32_t)(uint8_t)(p1[j]*((sg&(1u<<j))?-1:1))<<(8*j);
+  hi|=(uint32_t)(uint8_t)(p2[j]*((sg&(1u<<(j+4)))?-1:1))<<(8*j);
+ }
+ *reinterpret_cast<uint32_t*>(cd+ib*32+l*8)  =lo;
+ *reinterpret_cast<uint32_t*>(cd+ib*32+l*8+4)=hi;
+ if(l==0) sc[ib]=d*(0.5f+(float)(aux>>28))*0.5f;
+}
+
+// ---------------------------------------------------------------- IQ2_S (82 B, scale/16)
+// block: d(2) qs(64) qh(8) scales(8);  the upper 32 bytes of qs are the sign bits.
+__global__ void expand_iq2s_kernel(const uint8_t* __restrict__ w,int8_t* __restrict__ codes,float* __restrict__ scales,int nb_per_expert,int ne,int N,int K){
+ __shared__ uint64_t sG2[1024];
+ for(int i=threadIdx.x;i<1024;i+=blockDim.x) sG2[i]=G2D[i];
+ __syncthreads();
+ GATEUP_EXPAND_PROLOGUE;
+ const uint8_t* blk=w+(size_t)gid*82;
+ const float d=__half2float(*reinterpret_cast<const __half*>(blk));
+ const uint8_t* qs=blk+2;const uint8_t* qh=qs+64;const uint8_t* scb=qh+8;const uint8_t* sg0=qs+32;
+ float* sco=scales+((size_t)e*N+row)*(K/16)+(size_t)(b%kb_per_row)*16;
+ const int ib=idx>>2, l=idx&3;
+ const unsigned gi=(unsigned)qs[4*ib+l]|(((unsigned)qh[ib]<<(8-2*l))&0x300u);
+ const uint8_t* p=(const uint8_t*)(sG2+gi);
+ const uint8_t sgn=sg0[4*ib+l];
+ uint32_t lo=0,hi=0;
+ #pragma unroll
+ for(int j=0;j<4;j++){
+  lo|=(uint32_t)(uint8_t)(p[j]  *((sgn&(1u<<j))    ?-1:1))<<(8*j);
+  hi|=(uint32_t)(uint8_t)(p[4+j]*((sgn&(1u<<(j+4)))?-1:1))<<(8*j);
+ }
+ *reinterpret_cast<uint32_t*>(cd+ib*32+l*8)  =lo;
+ *reinterpret_cast<uint32_t*>(cd+ib*32+l*8+4)=hi;
+ if(l<2){ const uint8_t sb=scb[ib]; sco[2*ib+l]=d*(0.5f+(float)(l?(sb>>4):(sb&0xf)))*0.25f; }
+}
+
+// ---------------------------------------------------------------- IQ3_S (110 B, scale/32)
+// block: d(2) qs(64) qh(8) signs(32) scales(4)
+__global__ void expand_iq3s_kernel(const uint8_t* __restrict__ w,int8_t* __restrict__ codes,float* __restrict__ scales,int nb_per_expert,int ne,int N,int K){
+ __shared__ uint32_t sGS[512];
+ for(int i=threadIdx.x;i<512;i+=blockDim.x) sGS[i]=GSD[i];
+ __syncthreads();
+ GATEUP_EXPAND_PROLOGUE;
+ const uint8_t* blk=w+(size_t)gid*110;
+ const float d=__half2float(*reinterpret_cast<const __half*>(blk));
+ const uint8_t* qs=blk+2;const uint8_t* qh=qs+64;const uint8_t* sg=qh+8;const uint8_t* scb=sg+32;
+ float* sco=scales+((size_t)e*N+row)*(K/32)+(size_t)(b%kb_per_row)*8;
+ const int it=idx>>3, half=(idx>>2)&1, l=idx&3;
+ const uint8_t qhb=qh[2*it+half];
+ const int qbase=16*it+8*half, sbase=8*it+4*half;
+ const uint8_t s=sg[sbase+l];
+ const uint8_t* p1=(const uint8_t*)(sGS+(qs[qbase+2*l]  |(((unsigned)qhb<<(8-2*l))&256u)));
+ const uint8_t* p2=(const uint8_t*)(sGS+(qs[qbase+2*l+1]|(((unsigned)qhb<<(7-2*l))&256u)));
+ uint32_t lo=0,hi=0;
+ #pragma unroll
+ for(int j=0;j<4;j++){
+  lo|=(uint32_t)(uint8_t)(p1[j]*((s&(1u<<j))?-1:1))<<(8*j);
+  hi|=(uint32_t)(uint8_t)(p2[j]*((s&(1u<<(j+4)))?-1:1))<<(8*j);
+ }
+ *reinterpret_cast<uint32_t*>(cd+it*64+half*32+l*8)  =lo;
+ *reinterpret_cast<uint32_t*>(cd+it*64+half*32+l*8+4)=hi;
+ if(l==0){ const uint8_t s0=scb[it]; sco[2*it+half]=d*(1.0f+2.0f*(float)(half?(s0>>4):(s0&0xf))); }
+}
+
+// ---------------------------------------------------------------- IQ4_XS (136 B, scale/32, signed scales)
+// block: d(2) scales_h(2) scales_l(4) qs(128);  bytes 0..15 of a 32-group are the low nibbles,
+// bytes 16..31 the high nibbles, of the same 16 qs bytes.
+__global__ void expand_iq4xs_kernel(const uint8_t* __restrict__ w,int8_t* __restrict__ codes,float* __restrict__ scales,int nb_per_expert,int ne,int N,int K){
+ __shared__ int8_t sKN[16];
+ for(int i=threadIdx.x;i<16;i+=blockDim.x) sKN[i]=KND[i];
+ __syncthreads();
+ GATEUP_EXPAND_PROLOGUE;
+ const uint8_t* blk=w+(size_t)gid*136;
+ const float d=__half2float(*reinterpret_cast<const __half*>(blk));
+ uint16_t sh;__builtin_memcpy(&sh,blk+2,2);
+ const uint8_t* sl=blk+4;const uint8_t* qs=blk+8;
+ float* sco=scales+((size_t)e*N+row)*(K/32)+(size_t)(b%kb_per_row)*8;
+ const int ib=idx>>2, l=idx&3;
+ const bool high=(l>=2);
+ const uint8_t* q8=qs+16*ib+((l&1)<<3);
+ uint32_t lo=0,hi=0;
+ #pragma unroll
+ for(int j=0;j<4;j++){
+  const uint8_t q0=q8[j], q1=q8[4+j];
+  lo|=(uint32_t)(uint8_t)sKN[high?(q0>>4):(q0&0xf)]<<(8*j);
+  hi|=(uint32_t)(uint8_t)sKN[high?(q1>>4):(q1&0xf)]<<(8*j);
+ }
+ *reinterpret_cast<uint32_t*>(cd+ib*32+l*8)  =lo;
+ *reinterpret_cast<uint32_t*>(cd+ib*32+l*8+4)=hi;
+ if(l==0){
+  const int ls=((sl[ib/2]>>(4*(ib%2)))&0xf)|(((int)((sh>>(2*ib))&3))<<4);
+  sco[ib]=d*(float)(ls-32);
+ }
+}
+
+// ---------------------------------------------------------------- grouped MMAC GEMM
+// f16-20261014 ("f16 Dm"): the output element type is a parameter.  OT=float is the gate/up product (GU stays
+// FP32); OT=uint16_t is the MoE down product, whose destination Dm is FP16 now - the store rounds through
+// out_hf() (the same clamp + round-to-nearest-even as the engine's activation image), so the down GEMM writes
+// half the bytes and no extra pass is needed.  The accumulation itself is untouched (FP32, k ascending).
+__device__ __forceinline__ uint16_t out_hf(float f) {
+ return __half_as_ushort(__float2half_rn(isnan(f) ? f : fminf(fmaxf(f, -65504.0f), 65504.0f)));
+}
+// The store's cast, as a class template so both instantiations are plain specializations (a function template's
+// explicit specialization is what hipcc is pickiest about).
+template<typename OT> struct OutCast { __device__ __forceinline__ static OT cast(float v) { return (OT) v; } };
+template<> struct OutCast<uint16_t> {
+ __device__ __forceinline__ static uint16_t cast(float v) { return out_hf(v); }
+};
+// WSG = weight scale group (16 or 32 k-values per FP32 scale). WSG=16 is the IQ2_S layout.
+template<int MT,int NT,int KS,int WSG,bool LINEAR=false,typename OT=float>
+__global__ void __launch_bounds__(256) gemm_moe_staged(
+    const int8_t* __restrict__ codes,const float* __restrict__ wsc,
+    const Q8D4* __restrict__ x,const int* __restrict__ bounds,const int* __restrict__ dst,
+    OT* __restrict__ y,int N,int K,int rows)
+{
+ constexpr int BM=16*MT*4, BN=16*NT, NS=KS/32;
+ const int KSG=K/WSG;
+ __shared__ __align__(16) int8_t sA[BM][KS+16];
+ __shared__ __align__(16) int8_t sB[BN][KS+8];
+ // Per-k0 weight scales. Read straight from global inside the FMA loop this cost one scalar
+ // load per (lane, nt, j) -- 64 loads against 16 MMAC per thread per k0 -- and only `lg` varied,
+ // so a transaction broadcast 4 of 64 lanes. Staged once per k0 into LDS with the same indices
+ // and the same arithmetic, this is the 1.5-2.1x the component scan measured.
+ __shared__ float sS[BN][KS/WSG];   // NS cols at WSG=32, KS/16 at WSG=16 -- exact for both
+ const int t=threadIdx.x,lane=t&63,wave=t>>6;
+ const int lr=lane&15,lg=lane>>4;
+ const int e=blockIdx.z;
+ const int start=bounds[e],end=bounds[e+1];
+ if(start>=end)return;
+ const int m0=start+blockIdx.x*BM,n0=blockIdx.y*BN;
+ if(m0>=end)return;
+ float acc[MT][NT][4];
+ #pragma unroll
+ for(int i=0;i<MT;i++)
+  #pragma unroll
+  for(int j=0;j<NT;j++)
+   #pragma unroll
+   for(int q=0;q<4;q++) acc[i][j][q]=0.0f;
+ for(int k0=0;k0<K;k0+=KS){
+  const int b128=k0/128,off=k0%128;
+  {
+   constexpr int AV=KS/16;
+   for(int i=t;i<BM*AV;i+=256){
+    const int r=i/AV,v=i%AV;
+    uint4 val=make_uint4(0,0,0,0);
+    if(m0+r<end) val=*reinterpret_cast<const uint4*>(&x[(size_t)b128*rows+(m0+r)].q[off+v*16]);
+    *reinterpret_cast<uint4*>(&sA[r][v*16])=val;
+   }
+  }
+  {
+   constexpr int BV=KS/16;
+   for(int i=t;i<BN*BV;i+=256){
+    const int nn=i/BV,v=i%BV;
+    uint4 val=make_uint4(0,0,0,0);
+    if(n0+nn<N) val=*reinterpret_cast<const uint4*>(&codes[((size_t)e*N+n0+nn)*K+k0+v*16]);
+    *reinterpret_cast<uint4*>(&sB[nn][v*16])=val;
+   }
+  }
+  // stage this k0 iteration's scales: WSG==32 has one per 32 k, WSG==16 one per 16 k
+  if (WSG==32) {
+   for(int i=t;i<BN*NS;i+=256){
+    const int nn=i/NS,ks2=i%NS;
+    sS[nn][ks2]=(n0+nn<N)?wsc[((size_t)e*N+n0+nn)*KSG+k0/32+ks2]:0.0f;
+   }
+  } else {
+   for(int i=t;i<BN*(KS/16);i+=256){
+    const int nn=i/(KS/16),ks2=i%(KS/16);
+    sS[nn][ks2]=(n0+nn<N)?wsc[((size_t)e*N+n0+nn)*KSG+k0/16+ks2]:0.0f;
+   }
+  }
+  __syncthreads();
+  const bool lo_half=(lg<2);
+  #pragma unroll
+  for(int ks=0;ks<NS;ks++){
+   const int kb=k0/32+ks, sub=off/32+ks;
+   uint64_t a[MT];float av[MT];
+   #pragma unroll
+   for(int mt=0;mt<MT;mt++){
+    const int rr=(wave*MT+mt)*16+lr;
+    a[mt]=*reinterpret_cast<const uint64_t*>(&sA[rr][ks*32+lg*8]);
+    av[mt]=(m0+rr<end)?x[(size_t)b128*rows+(m0+rr)].d[sub]:0.0f;
+   }
+   #pragma unroll
+   for(int nt=0;nt<NT;nt++){
+    const uint64_t b=*reinterpret_cast<const uint64_t*>(&sB[nt*16+lr][ks*32+lg*8]);
+    #pragma unroll
+    for(int mt=0;mt<MT;mt++){
+     if (WSG==32) {
+      // Read the staged scale straight inside the fmaf. Materialising it into a float wv[4]
+      // first costs ~58 VGPR and 56 SGPR (ISA probe: 188->130 VGPR, 96->40 SGPR): four
+      // separately-addressable values kept live across the MMAC tip the allocator into a
+      // spill-avoidance schedule. The value is identical -- the staging loop above zero-fills
+      // sS[] for n0+nn>=N, so the (nn<N)?0:sS guard the old form carried was redundant.
+      I4 r={0,0,0,0};
+      r=__builtin_amdgcn_mmac_i32_16x16x32i8((long)a[mt],(long)b,r);
+      const float s=av[mt];
+      #pragma unroll
+      for(int j=0;j<4;j++) acc[mt][nt][j]=fmaf((float)r[j],s*sS[nt*16+lg+4*j][ks],acc[mt][nt][j]);
+     } else {
+      float wv0[4],wv1[4];
+      #pragma unroll
+      for(int j=0;j<4;j++){
+       const int nn=n0+nt*16+lg+4*j;
+       if(nn<N){ wv0[j]=sS[nt*16+lg+4*j][ks*2]; wv1[j]=sS[nt*16+lg+4*j][ks*2+1]; }
+       else { wv0[j]=0.0f; wv1[j]=0.0f; }
+      }
+      const uint64_t alo=lo_half?a[mt]:0ull, ahi=lo_half?0ull:a[mt];
+      I4 r0={0,0,0,0},r1={0,0,0,0};
+      r0=__builtin_amdgcn_mmac_i32_16x16x32i8((long)alo,(long)b,r0);
+      r1=__builtin_amdgcn_mmac_i32_16x16x32i8((long)ahi,(long)b,r1);
+      const float s=av[mt];
+      #pragma unroll
+      for(int j=0;j<4;j++){
+       acc[mt][nt][j]=fmaf((float)r0[j],s*wv0[j],acc[mt][nt][j]);
+       acc[mt][nt][j]=fmaf((float)r1[j],s*wv1[j],acc[mt][nt][j]);
+      }
+     }
+    }
+   }
+  }
+  __syncthreads();
+ }
+ #pragma unroll
+ // downlin-20261015: LINEAR writes y[rr*N+cc] directly, skipping the dst[] indirection.
+ // Valid and BIT-IDENTICAL only when dst is the identity table. Every MoE down call site passes an
+ // iota'd identity (prefill.cpp:3451/3522/3700 -> P.ident / m.ids_identity; iota at :2043), so
+ // dst[rr]==rr. Halide's decomposition put the scatter epilogue at ~82% of the down GEMM
+ // (0.805 ms alone vs 0.987 ms full) while the pure MMAC is only 0.385 ms.
+ for(int mt=0;mt<MT;mt++)
+  #pragma unroll
+  for(int nt=0;nt<NT;nt++)
+   #pragma unroll
+   for(int j=0;j<4;j++){
+    const int rr=m0+(wave*MT+mt)*16+lr,cc=n0+nt*16+lg+4*j;
+    if(rr<end&&cc<N){
+     if(LINEAR) y[(size_t)rr*N+cc]=OutCast<OT>::cast(acc[mt][nt][j]);
+     else       y[(size_t)dst[rr]*N+cc]=OutCast<OT>::cast(acc[mt][nt][j]);
+    }
+   }
+}
+
+// ---------------------------------------------------------------- IQ2_S (WSG=16) grouped MMAC GEMM
+// IQ2_S carries one scale per 16 k-values, but the only int8 MMA on gfx928 is 32 k deep
+// (__builtin_amdgcn_wmma_i32_16x16x16_iu8 needs gfx11-insts, which this part does not have). So a
+// 32-k window is split by zeroing the A fragment in the lanes that hold the wrong half (lane k
+// coverage is lg*8..lg*8+7), giving two exact 16-deep dots per MMAC pair.
+// Measured at rows=15408/16 experts: 4.40 ms here versus 3.59 ms for the WSG=32 kernel and
+// 10.11 ms for the naive version that keeps both weight scales in registers (which also spilled at
+// NT=8: 256 VGPR + 744 B). Reading the scales inline inside the FMA loop is what avoids the spill
+// (129 VGPR at NT=8, 76 at NT=4).
+// Same masking scheme as gemm_moe_staged<...,16>, but the two weight scales are read inline inside
+// the FMA loop instead of being kept in wv0[4]/wv1[4], to see whether the VGPR footprint drops below
+// the 256 cap at NT=8 (the shipped NT=8 version spills: 256 VGPR + 744 B private segment).
+template<int MT,int NT,int KS,bool LINEAR=false>
+__global__ void __launch_bounds__(256) gemm_moe_wsg16_lean(
+    const int8_t* __restrict__ codes,const float* __restrict__ wsc,
+    const Q8D4* __restrict__ x,const int* __restrict__ bounds,const int* __restrict__ dst,
+    float* __restrict__ y,int N,int K,int rows)
+{
+ constexpr int BM=16*MT*4, BN=16*NT, NS=KS/32;
+ const int KSG=K/16;
+ __shared__ __align__(16) int8_t sA[BM][KS+16];
+ __shared__ __align__(16) int8_t sB[BN][KS+8];
+ // Same LDS staging of the per-k0 scales as gemm_moe_staged (see the note there).
+ __shared__ float sS[BN][KS/16];
+ const int t=threadIdx.x,lane=t&63,wave=t>>6;
+ const int lr=lane&15,lg=lane>>4;
+ const int e=blockIdx.z;
+ const int start=bounds[e],end=bounds[e+1];
+ if(start>=end)return;
+ const int m0=start+blockIdx.x*BM,n0=blockIdx.y*BN;
+ if(m0>=end)return;
+ float acc[MT][NT][4];
+ #pragma unroll
+ for(int i=0;i<MT;i++)
+  #pragma unroll
+  for(int j=0;j<NT;j++)
+   #pragma unroll
+   for(int q=0;q<4;q++) acc[i][j][q]=0.0f;
+ for(int k0=0;k0<K;k0+=KS){
+  const int b128=k0/128,off=k0%128;
+  {
+   constexpr int AV=KS/16;
+   for(int i=t;i<BM*AV;i+=256){
+    const int r=i/AV,v=i%AV;
+    uint4 val=make_uint4(0,0,0,0);
+    if(m0+r<end) val=*reinterpret_cast<const uint4*>(&x[(size_t)b128*rows+(m0+r)].q[off+v*16]);
+    *reinterpret_cast<uint4*>(&sA[r][v*16])=val;
+   }
+  }
+  {
+   constexpr int BV=KS/16;
+   for(int i=t;i<BN*BV;i+=256){
+    const int nn=i/BV,v=i%BV;
+    uint4 val=make_uint4(0,0,0,0);
+    if(n0+nn<N) val=*reinterpret_cast<const uint4*>(&codes[((size_t)e*N+n0+nn)*K+k0+v*16]);
+    *reinterpret_cast<uint4*>(&sB[nn][v*16])=val;
+   }
+  }
+  for(int i=t;i<BN*(KS/16);i+=256){
+   const int nn=i/(KS/16),ks2=i%(KS/16);
+   sS[nn][ks2]=(n0+nn<N)?wsc[((size_t)e*N+n0+nn)*KSG+k0/16+ks2]:0.0f;
+  }
+  __syncthreads();
+  const uint64_t mlo=(lg<2)?~0ull:0ull;
+  #pragma unroll
+  for(int ks=0;ks<NS;ks++){
+   const int kb=k0/32+ks, sub=off/32+ks;
+   uint64_t a[MT];float av[MT];
+   #pragma unroll
+   for(int mt=0;mt<MT;mt++){
+    const int rr=(wave*MT+mt)*16+lr;
+    a[mt]=*reinterpret_cast<const uint64_t*>(&sA[rr][ks*32+lg*8]);
+    av[mt]=(m0+rr<end)?x[(size_t)b128*rows+(m0+rr)].d[sub]:0.0f;
+   }
+   #pragma unroll
+   for(int nt=0;nt<NT;nt++){
+    const uint64_t b=*reinterpret_cast<const uint64_t*>(&sB[nt*16+lr][ks*32+lg*8]);
+    #pragma unroll
+    for(int mt=0;mt<MT;mt++){
+     const uint64_t alo=a[mt]&mlo, ahi=a[mt]&~mlo;
+     I4 r0={0,0,0,0},r1={0,0,0,0};
+     r0=__builtin_amdgcn_mmac_i32_16x16x32i8((long)alo,(long)b,r0);
+     r1=__builtin_amdgcn_mmac_i32_16x16x32i8((long)ahi,(long)b,r1);
+     const float sv=av[mt];
+     #pragma unroll
+     for(int j=0;j<4;j++){
+      const int nn=n0+nt*16+lg+4*j;
+      if(nn<N){
+       const float w0=sS[nt*16+lg+4*j][ks*2], w1=sS[nt*16+lg+4*j][ks*2+1];
+       acc[mt][nt][j]=fmaf((float)r0[j],sv*w0,acc[mt][nt][j]);
+       acc[mt][nt][j]=fmaf((float)r1[j],sv*w1,acc[mt][nt][j]);
+      }
+     }
+    }
+   }
+  }
+  __syncthreads();
+ }
+ #pragma unroll
+ for(int mt=0;mt<MT;mt++)
+  #pragma unroll
+  for(int nt=0;nt<NT;nt++)
+   #pragma unroll
+   for(int j=0;j<4;j++){
+    const int rr=m0+(wave*MT+mt)*16+lr,cc=n0+nt*16+lg+4*j;
+    if(rr<end&&cc<N){
+     if(LINEAR) y[(size_t)rr*N+cc]=acc[mt][nt][j];
+     else       y[(size_t)dst[rr]*N+cc]=acc[mt][nt][j];
+    }
+   }
+}
