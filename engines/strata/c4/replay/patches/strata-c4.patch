+#pragma unroll
+    for (int kk = 0; kk < 4; ++kk) {
+        float x[4];
+        if (r < G) {
+            const float* src = q + (size_t) r * HD + dim0 + kk * 16 + grp * 4;
+#pragma unroll
+            for (int k = 0; k < 4; ++k) x[k] = src[k];
+        } else {
+#pragma unroll
+            for (int k = 0; k < 4; ++k) x[k] = 0.0f;
+        }
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            const float v = x[k] * qup;
+            const _Float16 hi = (_Float16) v;
+            qh[kk][k] = hi;
+            ql[kk][k] = (_Float16) (v - (float) hi);
+        }
+    }
+
+    mm_f4 acc[4];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) acc[j] = mm_f4{0.f, 0.f, 0.f, 0.f};
+
+    const int n_chunks = (n + MWCH - 1) / MWCH;
+    for (int ci = 0; ci < n_chunks; ++ci) {
+        const int c0 = ci * MWCH;
+        const int mycell = lane & 31, vhalf = lane >> 5;
+        const int cell0 = c0 + mycell;
+        int myrow = -1;
+        if (cell0 < n) {
+            const int cc = __ldg(ids + cell0);
+            const int page = __ldg(p.page_table + cc / page_size);
+            if (page >= 0) myrow = (page * n_kv_heads + kvh) * page_size + (cc % page_size);
+        }
+        {   // stage this wave's 64 dims of this lane's cell as FP16, plus the cell's V scale
