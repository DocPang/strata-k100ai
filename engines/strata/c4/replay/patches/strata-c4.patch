+// ---- gfx928: the int8-KV prompt attention on the DCU's native FP16 matrix instruction (opt-in: STRATA_HIP_WMMA=1).
+// `__builtin_amdgcn_mmac_f32_16x16x16f16` is Hygon's MMAC; AMD's v_mfma_* family is an ILLEGAL INSTRUCTION on this
+// part (measured, see experiments/20261011-integer-mmac-probe), so the RDNA kernels above cannot be reused as they
+// are.  The fragment layout was measured on the card (mmac_f16_probe.hip, bijective + graph-replay checked) and
+// differs from RDNA's v_wmma:
+//   A lane l holds A[l % 16][(l / 16) * 4 + k], B lane l holds B[(l / 16) * 4 + k][l % 16],
+//   C lane l holds C[l % 16][(l / 16) + 4 * j],  k, j = 0..3.
+// The wave is 64 lanes, so a block is 4 waves and wave w owns the 64 head_dim dims of int8 scale group w - the same
+// split the RDNA kernel makes with its 4 warps.  The design (online softmax, exact int8->FP16 codes, per-64 scales
+// applied in FP32, q and p carried as FP16 hi+lo) is the RDNA kernel's, so its accuracy contract carries over.
+constexpr int MWCH = 32;          // cells per chunk (two 16-cell tiles)
+constexpr int MTHREADS = 256;     // 4 waves of 64
+struct alignas(16) SmemM {
+    float part[4][16][MWCH + 1];  // q.k per dim group (wave)
+    float p[16][MWCH + 1];
+    float vs[4][MWCH];            // V scale per (wave, cell)
+    int valid[MWCH];
+    int8_t v[4][MWCH][KV_Q8_GROUP];     // this wave's V codes of its group, raw int8 (exact in FP16)
+    float qmax[4];
+    float alpha[16];
+    float lsum[16];
+    float mrow[16];
+};
+typedef _Float16 mm_h4 __attribute__((ext_vector_type(4)));
+typedef float mm_f4 __attribute__((ext_vector_type(4)));
+__device__ __forceinline__ mm_f4 mmac16(mm_h4 a, mm_h4 b, mm_f4 c) {
+    return __builtin_amdgcn_mmac_f32_16x16x16f16(a, b, c);
+}
