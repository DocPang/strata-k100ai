+// identical to gateup_exact::out_hf
+__device__ __forceinline__ uint16_t out_hf(float f) {
+    return __half_as_ushort(__float2half_rn(isnan(f) ? f : fminf(fmaxf(f, -65504.0f), 65504.0f)));
