@@ -303,3 +312,21 @@
     }
     return c;
 }
+
+// [k100ai] DTK 5.2 cooperative_groups asm bug on gfx928 → disable coop kernels
+#define GGML_HIP_NO_COOP 1
+
+// [k100ai] Minimal cooperative_groups stubs for DTK 5.2 (asm bug in real header on gfx928).
+// These compile but are never called: supports_cooperative_launch is false at runtime.
+#if defined(GGML_HIP_NO_COOP)
+namespace cooperative_groups {
+    struct grid_group {
+        __device__ void sync() const {
+            // grid sync requires cooperative launch; this stub is never reached
+        }
+        __device__ unsigned long long size() const { return 1; }
+        __device__ unsigned long long thread_rank() const { return 0; }
+    };
+    __device__ inline grid_group this_grid() { return grid_group(); }
+}
+#endif
