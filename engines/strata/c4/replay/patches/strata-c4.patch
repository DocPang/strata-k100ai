+            if (myrow >= 0) {
+                const int8_t* src = p.v_q + (size_t) myrow * HD + dim0 + vhalf * 32;
+#pragma unroll
+                for (int d = 0; d < 32; ++d) S.v[wave][mycell][vhalf * 32 + d] = src[d];
+                vsc = __half2float(__ushort_as_half(__ldg(p.v_scale + (size_t) myrow * (HD / KV_Q8_GROUP) + wave)));
+            } else {
+#pragma unroll
+                for (int d = 0; d < 32; ++d) S.v[wave][mycell][vhalf * 32 + d] = (int8_t) 0;
