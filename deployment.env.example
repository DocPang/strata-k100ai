# Absolute host paths. No model weights are included in the release.
MODEL_DIR=/srv/models/next-iq3xxs
SHARD1=Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf
SHARD2=Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00002-of-00002.gguf
PACK_DIR=/srv/packs/next-iq3xxs
MTP_DIR=/srv/mtp-runtime
HYHAL_DIR=/opt/hyhal
# Select an idle physical GPU by its actual render node. Do not copy another host's card number.
RENDER_DEVICE=/dev/dri/renderD128
PROFILE=next-iq3xxs-single
INSTANCE=next-iq3xxs-single
BIND_HOST=127.0.0.1
PORT=8080
STRATA_API_KEY=CHANGE_ME_GENERATE_A_PRIVATE_KEY
# Optional control vector: mount its directory as EXTRAS_DIR and set its container path.
EXTRAS_DIR=./extras
CONTROL_VECTOR=
